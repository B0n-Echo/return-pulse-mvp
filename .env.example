# Copy this file to .env and fill in your values. Never commit .env.

# Address of the Postgres database that holds the Return Pulse data.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE (leave out ":PASSWORD" if you don't use one)
DATABASE_URL=postgresql://learner@localhost:5432/dhaga

# OpenRouter key and the two models, for the AI step
OPENROUTER_API_KEY=
CHEAP_MODEL=openai/gpt-4o-mini
STRONG_MODEL=openai/gpt-4o
